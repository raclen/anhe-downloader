# 统一换行符：文本文件使用 LF，Windows 批处理使用 CRLF
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.syso binary
*.woff binary
*.woff2 binary

# 生成文件
frontend/dist/** linguist-generated=true
pnpm-lock.yaml linguist-generated=true
